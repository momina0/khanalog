# --- AI (OpenRouter) ---------------------------------------------------------
# openrouter.ai -> Keys -> Create Key
OPENROUTER_API_KEY=sk-or-v1-...
# Cheap, fast model with tool calling and vision (~$0.0003 per message).
# Free ":free" models work too but get retired without notice; the MiniMax one
# this project first ran on disappeared the day after launch.
TEXT_MODEL=deepseek/deepseek-v4.1-flash
VISION_MODEL=deepseek/deepseek-v4.1-flash
# Used automatically if the primary returns an empty reply or is down.
FALLBACK_MODEL=qwen/qwen3.7-flash

# --- Accounts (Clerk) --------------------------------------------------------
# clerk.com -> your app -> API Keys. Free up to 10k monthly users.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# --- Database (Neon Postgres) ------------------------------------------------
# Vercel project -> Storage -> Create Database -> Neon, or neon.tech -> Connection string.
# Then run `npm run db:push` once to create the tables.
DATABASE_URL=postgres://...

# --- Demo sandbox ------------------------------------------------------------
# Let visitors try a throwaway sandbox from the login page (portfolio demo).
DEMO_ENABLED=true
# Messages a demo visitor may send per day.
DEMO_DAILY_LIMIT=25
# Optional: secret for signing the demo cookie (defaults to CLERK_SECRET_KEY).
APP_SECRET=

# --- Misc --------------------------------------------------------------------
# Your deployed URL, e.g. https://khanalog.vercel.app (sent to OpenRouter as the referer)
PUBLIC_URL=
# Fallback timezone until the user sets one in their profile
DEFAULT_TIMEZONE=Asia/Karachi
